	measure 'Trunk payload share' = DIVIDE ( CALCULATE ( [Fleet payload lbs], D_Aircraft[Class] = "Trunk", REMOVEFILTERS ( D_Aircraft ) ), [Payload total] )
		formatString: 0.0%
		displayFolder: 02 Payload & capacity
