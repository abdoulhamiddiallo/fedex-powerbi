		lineageTag: 201106f2-5d5b-56ce-a459-ba748cbc879a

	/// Consolidated revenue for the fiscal year in context, USD millions.
	measure Revenue = VAR y = MAX ( F_Financial[FiscalYear] ) RETURN CALCULATE ( SUM ( F_Financial[Revenue] ), F_Financial[FiscalYear] = y )
		formatString: #,0
		displayFolder: 05 Financial
		lineageTag: 607f24f9-51f8-5bce-9ac7-4262976198a7

	measure 'Revenue bn' = DIVIDE ( [Revenue], 1000 )
		formatString: #,0.0
		displayFolder: 05 Financial
		lineageTag: 68ccf100-f726-5d7a-b0cf-0d373f4e2eec

	measure 'Revenue LY' = CALCULATE ( [Revenue], D_FiscalYear[FiscalYear] = MAX ( F_Financial[FiscalYear] ) - 1 )
		formatString: #,0
		displayFolder: 05 Financial
		lineageTag: 337ee6ae-aa1b-50d9-87e9-5bdde79fc7cc

	measure 'Revenue growth' = DIVIDE ( [Revenue] - [Revenue LY], [Revenue LY] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 05 Financial
		lineageTag: 9c10abc9-a0f9-5668-a237-30ad3b517858

	measure 'Operating income' = VAR y = MAX ( F_Financial[FiscalYear] ) RETURN CALCULATE ( SUM ( F_Financial[OperatingIncome] ), F_Financial[FiscalYear] = y )
		formatString: #,0
		displayFolder: 05 Financial
		lineageTag: daf02405-4ced-536a-8a19-79d583b24d5a

	measure 'Operating margin' = DIVIDE ( [Operating income], [Revenue] )
		formatString: 0.0%
		displayFolder: 05 Financial
		lineageTag: 34ef322d-abd3-5c70-9f86-cba92f9143c5

	measure 'Net income' = VAR y = MAX ( F_Financial[FiscalYear] ) RETURN CALCULATE ( SUM ( F_Financial[NetIncome] ), F_Financial[FiscalYear] = y )
		formatString: #,0
		displayFolder: 05 Financial
		lineageTag: 68768e52-94f0-5727-8937-fbd54325f60a

	measure 'Net margin' = DIVIDE ( [Net income], [Revenue] )
		formatString: 0.0%
		displayFolder: 05 Financial
		lineageTag: 160507d8-ff84-5274-b826-f035c3b15e55

	measure EPS = VAR y = MAX ( F_Financial[FiscalYear] ) RETURN CALCULATE ( SUM ( F_Financial[EPSDiluted] ), F_Financial[FiscalYear] = y )
		formatString: $#,0.00
		displayFolder: 05 Financial
		lineageTag: 7186e4e1-8fbb-5a48-9f39-0890672a6eb5

	measure Capex = VAR y = MAX ( F_Financial[FiscalYear] ) RETURN CALCULATE ( SUM ( F_Financial[Capex] ), F_Financial[FiscalYear] = y )
