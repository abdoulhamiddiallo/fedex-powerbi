	/// Change in the number of aircraft of each type between FY2023 and FY2026.
	measure 'vs FY23' = VAR b = CALCULATE ( [Aircraft], REMOVEFILTERS ( D_FiscalYear ), F_Fleet[FiscalYear] = 2023 ) VAR n = CALCULATE ( [Aircraft], REMOVEFILTERS ( D_FiscalYear ), F_Fleet[FiscalYear] = 2026 ) RETURN n - b
		formatString: +#,0;-#,0;0
		displayFolder: 01 Fleet
		lineageTag: 5afef4d9-0ef5-5f61-a0ce-f9bdb836f769

