	measure 'Revenue, $m' = VAR y = MAX ( F_Segment[FiscalYear] ) RETURN CALCULATE ( SUM ( F_Segment[Revenue] ), F_Segment[FiscalYear] = y )
		formatString: #,0
		displayFolder: 05 Financial
		lineageTag: e6e562bd-14fd-5bdb-ad89-a4fcee86dbe9

	measure 'Op income, $m' = VAR y = MAX ( F_Segment[FiscalYear] ) RETURN CALCULATE ( SUM ( F_Segment[OperatingIncome] ), F_Segment[FiscalYear] = y )
		formatString: #,0
		displayFolder: 05 Financial
		lineageTag: 59dd1ef3-d59c-5a6c-a266-8e3cfda813bb

	measure Margin = DIVIDE ( [Op income, $m], [Revenue, $m] )
