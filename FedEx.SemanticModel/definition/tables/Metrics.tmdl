table Metrics
	lineageTag: 83a058fb-34b0-50ea-93a5-8682f2218f52

	/// Aircraft in the fleet at the close of the fiscal year in context.
	measure Aircraft = VAR y = MAX ( F_Fleet[FiscalYear] ) RETURN CALCULATE ( SUM ( F_Fleet[Aircraft] ), F_Fleet[FiscalYear] = y )
		formatString: #,0
		displayFolder: 01 Fleet
		lineageTag: 52852590-4eb1-5002-bd96-ce11ab3b0d96

	measure 'Aircraft LY' = CALCULATE ( [Aircraft], D_FiscalYear[FiscalYear] = MAX ( F_Fleet[FiscalYear] ) - 1 )
		formatString: #,0
		displayFolder: 01 Fleet
		lineageTag: a49bc045-d79d-5672-a988-da859e4d08ca

	measure 'Aircraft change' = [Aircraft] - [Aircraft LY]
		formatString: +#,0;-#,0;0
		displayFolder: 01 Fleet
		lineageTag: 9518ab27-db75-5380-b7b8-4f9ca337def6

	measure 'Fleet total' = CALCULATE ( [Aircraft], REMOVEFILTERS ( D_Aircraft ) )
		formatString: #,0
		displayFolder: 01 Fleet
		lineageTag: fc6112c9-b068-5463-9169-17112259e444

	measure 'Aircraft owned' = SUM ( D_Aircraft[Owned] )
		formatString: #,0
		displayFolder: 01 Fleet
		lineageTag: 86d4483c-f6a3-5242-a498-a4095fd5f396

	measure 'Aircraft leased' = SUM ( D_Aircraft[Leased] )
		formatString: #,0
		displayFolder: 01 Fleet
		lineageTag: 951148e3-b4db-592d-919f-f01cc92ef842

	measure 'Aircraft on order' = SUM ( D_Aircraft[OnOrder] )
		formatString: #,0
		displayFolder: 01 Fleet
		lineageTag: 33ad7fe9-bb78-5dbe-8660-22472d9c6e12

	/// Delivered aircraft undergoing pre-service modification at 31 May 2026.
	measure 'Aircraft in modification' = SUM ( D_Aircraft[NotInService] )
		formatString: #,0
		displayFolder: 01 Fleet
		lineageTag: 43d8efeb-4088-5fa5-a34d-e1e2425dd457

	measure 'Owned share' = DIVIDE ( [Aircraft owned], [Aircraft owned] + [Aircraft leased] )
		formatString: 0.0%
		displayFolder: 03 Fleet mix
		lineageTag: 34e787a8-8163-5c18-aa84-5cfa9ab85182

	measure 'Leased share' = DIVIDE ( [Aircraft leased], [Aircraft owned] + [Aircraft leased] )
		formatString: 0.0%
		displayFolder: 03 Fleet mix
		lineageTag: 09d53b06-2840-5812-a56f-9f6dadd6f974

	measure 'Trunk aircraft' = CALCULATE ( [Aircraft], D_Aircraft[Class] = "Trunk" )
		formatString: #,0
		displayFolder: 03 Fleet mix
		lineageTag: 358d7380-3599-53d6-ab81-b8bb03a3cbd5

	measure 'Feeder aircraft' = CALCULATE ( [Aircraft], D_Aircraft[Class] = "Feeder" )
		formatString: #,0
		displayFolder: 03 Fleet mix
		lineageTag: 0667b5ae-8244-5a0f-acd0-48408a5c1dc2

	measure 'Trunk share' = DIVIDE ( [Trunk aircraft], [Fleet total] )
		formatString: 0.0%
		displayFolder: 03 Fleet mix
		lineageTag: f5a6e64c-2e80-5572-9d15-14ce5cfadb08

	measure 'Boeing aircraft' = CALCULATE ( [Aircraft], D_Aircraft[IsBoeing] = 1 )
		formatString: #,0
		displayFolder: 03 Fleet mix
		lineageTag: b919cf35-c7e5-58d6-9ea0-48ddabb85ba1

	/// Share of the total fleet built by Boeing, including the MD-11 trijet.
	measure 'Boeing share' = DIVIDE ( CALCULATE ( [Aircraft], D_Aircraft[IsBoeing] = 1, REMOVEFILTERS ( D_Aircraft ) ), [Fleet total] )
		formatString: 0.0%
		displayFolder: 03 Fleet mix
		lineageTag: 2594985a-4e1f-5570-92ea-a6846e1b957c

	measure 'Manufacturer share' = DIVIDE ( [Aircraft], [Fleet total] )
		formatString: 0.0%
		displayFolder: 03 Fleet mix
		lineageTag: 958c984e-1129-5d7a-b9ae-8dac8a92ff5a

	/// Sum of maximum gross structural payload across every aircraft in the fleet.
	measure 'Fleet payload lbs' = VAR y = MAX ( F_Fleet[FiscalYear] ) RETURN CALCULATE ( SUM ( F_Fleet[PayloadLbs] ), F_Fleet[FiscalYear] = y )
		formatString: #,0
		displayFolder: 02 Payload & capacity
		lineageTag: 47f8bbab-f6a2-50d4-807e-89f494e2c383

	measure 'Fleet payload Mlbs' = DIVIDE ( [Fleet payload lbs], 1000000 )
		formatString: #,0.0
		displayFolder: 02 Payload & capacity
		lineageTag: cc169190-194d-556e-af24-47c01ed495d3

	measure 'Fleet payload tonnes' = DIVIDE ( [Fleet payload lbs], 2204.62 )
		formatString: #,0
		displayFolder: 02 Payload & capacity
		lineageTag: d8a88c7f-1cca-53b7-ae0b-93a7c0c83df0

	measure 'Payload total' = CALCULATE ( [Fleet payload lbs], REMOVEFILTERS ( D_Aircraft ) )
		formatString: #,0
		displayFolder: 02 Payload & capacity
		lineageTag: 913f3079-a501-52ea-882f-14d6cb967caf

	/// Average maximum payload per aircraft, in pounds.
	measure 'Average payload' = DIVIDE ( [Fleet payload lbs], [Aircraft] )
