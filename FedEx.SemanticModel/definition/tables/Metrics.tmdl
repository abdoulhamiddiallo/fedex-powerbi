		lineageTag: ba7b271f-f5b7-5a92-972a-f6f7e986e686

	measure 'Geography revenue' = VAR y = MAX ( F_Geography[FiscalYear] ) RETURN CALCULATE ( SUM ( F_Geography[Revenue] ), F_Geography[FiscalYear] = y )
