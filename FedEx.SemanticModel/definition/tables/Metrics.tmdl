	/// Average daily package volume, thousands of packages.
	measure 'Daily packages' = SUM ( F_Service[Daily volume (k)] )
		formatString: #,0
		displayFolder: 06 Volumes & yield
		lineageTag: 2f4bf7e3-61ad-5686-8931-4942485a5f23

	measure 'Daily packages m' = DIVIDE ( [Daily packages], 1000 )
		formatString: #,0.0
		displayFolder: 06 Volumes & yield
		lineageTag: 0b497d75-5dee-586a-a82b-a1b8ddffca42

	measure 'Daily packages LY' = SUM ( F_Service[ADVPrior] )
		formatString: #,0
		displayFolder: 06 Volumes & yield
		lineageTag: cf43fb11-6e21-5e8b-b989-bafddb104216

	measure 'Volume growth' = DIVIDE ( [Daily packages] - [Daily packages LY], [Daily packages LY] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 06 Volumes & yield
		lineageTag: 0c5bbc7d-78c0-5e2e-968d-f3ec07e57c35

	/// Revenue per package, derived from annual revenue and 252 operating days.
	measure Yield = DIVIDE ( [Service revenue] * 1000, [Daily packages] * 252 )
		formatString: $#,0.00
		displayFolder: 06 Volumes & yield
		lineageTag: 666bbeb7-9a01-553e-b501-deba0c0aa76d

	measure 'Reported yield' = AVERAGE ( F_Service[Yield ($)] )
		formatString: $#,0.00
		displayFolder: 06 Volumes & yield
		lineageTag: 5ffb0674-00c7-5916-aaf4-fc98a3f73e47

	measure 'LTL shipments' = CALCULATE ( SUM ( F_Freight[ShipmentsPerDay] ), F_Freight[FiscalYear] = MAX ( F_Freight[FiscalYear] ) )
		formatString: #,0
		displayFolder: 06 Volumes & yield
		lineageTag: 25dfcebb-12dd-5353-a2c2-b1c6feda0f23

	measure 'LTL revenue per shipment' = CALCULATE ( AVERAGE ( F_Freight[RevenuePerShipment] ), F_Freight[FiscalYear] = MAX ( F_Freight[FiscalYear] ) )
