	measure 'Boeing payload share' = DIVIDE ( CALCULATE ( [Fleet payload lbs], D_Aircraft[IsBoeing] = 1, REMOVEFILTERS ( D_Aircraft ) ), [Payload total] )
		formatString: 0.0%
		displayFolder: 02 Payload & capacity
