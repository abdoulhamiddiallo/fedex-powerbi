		lineageTag: 45eb32a3-e0b5-5fb7-be49-94cb5fc7e40f

	measure 'Lease label' = FORMAT ( MIN ( D_Hub[Lease to] ), "0" )
		displayFolder: 08 Narrative
		lineageTag: 46132e5b-5f57-5f34-912f-422cd2f00786

	column Placeholder
		dataType: string
		isHidden
		lineageTag: b2ab0a2d-fe2f-50f8-83be-479a8ac428d5
		summarizeBy: none
		sourceColumn: [Placeholder]

		annotation SummarizationSetBy = Automatic

	partition Metrics = calculated
		mode: import
