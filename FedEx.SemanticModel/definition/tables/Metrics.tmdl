	/// Direct greenhouse gas emissions, metric tons CO2e.
	measure 'Scope 1' = VAR y = MAX ( F_Climate[FiscalYear] ) RETURN CALCULATE ( SUM ( F_Climate[Scope1] ), F_Climate[FiscalYear] = y )
		formatString: #,0
