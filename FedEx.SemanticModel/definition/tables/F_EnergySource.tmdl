table F_EnergySource
	lineageTag: b999ef2c-7539-5f8f-9fda-5d6d579fb7a3

	column FiscalYear
		dataType: int64
		formatString: 0
		lineageTag: 54b7e2fa-68cc-5dfa-a218-4202132784c4
		summarizeBy: none
		sourceColumn: FiscalYear

		annotation SummarizationSetBy = Automatic

	column Source
		dataType: string
		lineageTag: ae720e26-1e96-5d0a-af6a-a9dcabb0f129
		summarizeBy: none
		sourceColumn: Source
		sortByColumn: SortOrder

		annotation SummarizationSetBy = Automatic

	column Energy
		dataType: int64
		formatString: #,0
		lineageTag: ef323184-dedc-5779-a071-a0804a2df75c
		summarizeBy: none
		sourceColumn: Energy

		annotation SummarizationSetBy = Automatic

	column SortOrder
		dataType: int64
		isHidden
		formatString: #,0
