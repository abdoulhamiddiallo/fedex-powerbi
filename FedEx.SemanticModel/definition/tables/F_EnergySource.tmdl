	partition F_EnergySource = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DossierDonnees & "\F_EnergySource.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Entetes = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Types = Table.TransformColumnTypes(Entetes, {{"FiscalYear", Int64.Type}, {"Source", type text}, {"Energy", Int64.Type}, {"SortOrder", Int64.Type}, {"Pillar", type text}}, "en-US")
				in
				    Types

	annotation PBI_ResultType = Table
